{
  "name": "hs-bg-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Помощник для Hearthstone Battlegrounds: читает Power.log и советует ходы",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "capture": "tsx src/ui/capture.ts",
    "demo:phase1": "tsx src/ui/demo-phase1.ts",
    "spike:battle": "tsx src/advisors/battle/spike.ts",
    "calibrate": "tsx src/advisors/battle/calibrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.0",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@firestone-hs/simulate-bgs-battle": "^1.1.726"
  }
}
