{
  "name": "hs-bg-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Помощник для Hearthstone Battlegrounds: читает Power.log и советует ходы",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "capture": "tsx src/ui/capture.ts",
    "watch": "tsx src/ui/watch.ts",
    "collector": "npm run build && electron dist/app/main.js",
    "overlay": "npm run build && electron dist/app/main.js --overlay",
    "collect": "tsx src/collector/cli.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.copyFileSync('src/overlay/index.html','dist/overlay/index.html');fs.cpSync('src/app/icons','dist/app/icons',{recursive:true})\"",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --dir",
    "demo:phase1": "tsx src/ui/demo-phase1.ts",
    "demo:phase3": "tsx src/ui/demo-phase3.ts",
    "demo:phase4": "tsx src/ui/demo-phase4.ts",
    "spike:battle": "tsx src/advisors/battle/spike.ts",
    "spike:position": "tsx src/advisors/position/spike.ts",
    "spike:field": "tsx src/advisors/position/spikeField.ts",
    "spike:buff": "tsx src/advisors/tavern/spikeBuff.ts",
    "spike:level": "tsx src/advisors/tavern/spikeLevel.ts",
    "spike:taunt": "tsx src/advisors/tavern/spikeTaunt.ts",
    "spike:hand": "tsx src/advisors/tavern/spikeHand.ts",
    "spike:horizon": "tsx src/advisors/tavern/spikeHorizon.ts",
    "calibrate": "tsx src/advisors/battle/calibrate.ts",
    "validate:tavern": "tsx src/advisors/tavern/validate.ts",
    "validate:spend": "tsx src/advisors/tavern/validateSpend.ts",
    "update:cards": "tsx src/data/updateCards.ts",
    "update:bgstats": "tsx src/data/updateBgStats.ts",
    "update:cardstats": "tsx src/data/updateCardStats.ts",
    "dataset:backfill": "tsx src/dataset/backfill.ts",
    "dataset:import": "tsx src/dataset/importCli.ts",
    "ml:eval": "tsx src/ml/report.ts",
    "ml:eval3": "tsx src/ml/report.ts --features=relative",
    "ml:imitation": "tsx src/ml/imitationReport.ts",
    "ml:track": "tsx src/ml/track.ts",
    "measure:cardstats": "tsx src/advisors/tavern/measureCardStats.ts",
    "analyze:cardstats": "tsx src/advisors/tavern/analyzeCardStats.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "electron": "^43.4.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "@firestone-hs/simulate-bgs-battle": "^1.1.737"
  },
  "main": "dist/app/main.js",
  "author": "Nikita"
}
