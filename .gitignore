node_modules/
dist/
*.tsbuildinfo
coverage/

# Сырые логи, скопированные для разбора, но ещё не оформленные как fixture.
# Оформленные fixtures в data/fixtures/ коммитятся.
data/logs-raw/

# Сырые транскрипты чатов разработки: сырьё, а не знание. Всё нужное
# перенесено в CLAUDE.md, docs/ и коммиты; README в папке коммитится.
chat-history/*.jsonl

# Скриншоты для сверки разметки. В git не кладём: PNG по 5 МБ почти не жмутся,
# восемь штук дали +40 МБ. Выводы из них живут в partN.expected.json,
# сами картинки — сырьё, хранятся локально.
data/screenshots/

# Windows
Thumbs.db
desktop.ini

# Датасет собственных партий (фаза 6): личные накопления, не фикстуры.
# Пишется живым режимом на конце каждой партии; досбор — dataset:backfill.
data/dataset/

# Черновики замеров: профили, бенчмарки, дампы состояний. Они копятся в корне
# при разборе производительности (тот самый «ход советника стал быстрее
# на 9–31%») и остаются лежать; выводы из них живут в docs/ и CLAUDE.md,
# а сами файлы — одноразовое сырьё. Держать их неигнорируемыми плохо
# по двум причинам: `git add -A` затащит их в историю, а `npm run lint`
# спотыкается о них (в tsconfig они не входят).
*-tmp.ts
*-tmp.mjs
*-tmp.json
analyze-prof*.mjs
bench-prof*/
*.cpuprofile
